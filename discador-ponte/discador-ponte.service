[Unit]
Description=Ponte do discador (Alexandria <-> Asterisk)
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
User=asterisk
Group=asterisk
EnvironmentFile=/etc/discador-ponte.env
ExecStart=/usr/bin/node /opt/discador-ponte/ponte.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
