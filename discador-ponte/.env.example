# Copie para /etc/discador-ponte.env e preencha. Esse arquivo tem segredos: chmod 600.

# Endereço do Alexandria (sem barra no fim)
ALEXANDRIA_URL=https://alexandrialeads.app
# Mesma senha-longa (mínimo 24 caracteres) que você colocar no Alexandria em DISCADOR_PONTE_TOKEN
DISCADOR_PONTE_TOKEN=

# ARI do Asterisk (só dentro da VPS). A senha está no DADOS-DO-TESTE.txt
ARI_URL=http://127.0.0.1:8088
ARI_USER=alexandria
ARI_SENHA=
ARI_APP=alexandria

# Como o Asterisk liga para o cliente. {numero} vira DDD+telefone (ex.: 11999998888).
# Troque trunk-operadora pelo nome do tronco no pjsip_operadora.conf.
TRONCO=PJSIP/{numero}@trunk-operadora
# Número que aparece para o cliente (opcional; use o número que a operadora liberou)
CALLER_ID=

RAMAIS_CONF=/etc/asterisk/pjsip_ramais.conf
PASTA_GRAVACAO=/var/spool/asterisk/recording
